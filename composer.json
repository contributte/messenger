{
    "name": "contributte/messenger",
    "description": "Best Symfony Messenger for Nette framework",
    "keywords": [
        "nette",
        "symfony",
        "messenger",
        "async",
        "consumer",
        "publisher"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/contributte/messenger",
    "authors": [
        {
            "name": "Milan Felix Šulc",
            "homepage": "https://f3l1x.io"
        }
    ],
    "require": {
        "ext-json": "*",
        "php": ">=8.2",
        "nette/di": "^3.1.2",
        "psr/container": "^2.0.2",
        "psr/cache": "^2.0.0 || ^3.0.0",
        "psr/log": "^2.0.0 || ^3.0.0",
        "symfony/messenger": "^7.4.4 || ^8.0.7",
        "symfony/event-dispatcher": "^7.4.4 || ^8.0.7",
        "symfony/console": "^7.4.4 || ^8.0.7",
        "symfony/var-dumper": "^7.4.4 || ^8.0.7"
    },
    "require-dev": {
        "mockery/mockery": "^1.3.3",
        "symfony/redis-messenger": "^7.4.4 || ^8.0.7",
        "symfony/amqp-messenger": "^7.4.4 || ^8.0.7",
        "symfony/doctrine-messenger": "^7.4.4 || ^8.0.7",
        "symfony/cache": "^7.4.4 || ^8.0.7",
        "doctrine/dbal": "^4.4.2",
        "doctrine/orm": "^3.6.2",
        "contributte/console": "~0.10.0",
        "contributte/event-dispatcher": "~0.9.0",
        "contributte/qa": "~0.4.0",
        "contributte/tester": "~0.4.0",
        "contributte/phpstan": "~0.3.0",
        "tracy/tracy": "^2.10.2"
    },
    "autoload": {
        "psr-4": {
            "Contributte\\Messenger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.2.x-dev"
        }
    }
}
